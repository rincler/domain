{
    "name": "rincler/domain",
    "description": "A domain name value object that supports IDN and Punycode, FQDN, validates input, and provides easy access to the domain level, labels, zone, TLD, eTLD and eTLD+1.",
    "keywords": ["domain", "IDN", "Punycode" ,"FQDN", "TLD", "eTLD"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rincler\\Domain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rincler\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.3.0",
        "ext-intl" : "*",
        "ext-mbstring" : "*",
        "myclabs/php-enum": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
